      <view class="COptionMenu" control-tag="BassLock" origin="240, 253" size="96, 22" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
      <view class="CTextLabel" origin="354, 238" size="96, 14" title="DRUMS" font="Small" font-color="Muted" text-alignment="center" transparent="true"/>
      <view class="COptionMenu" control-tag="DrumsLock" origin="354, 253" size="96, 22" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
      <view class="CTextLabel" origin="468, 238" size="96, 14" title="PADS" font="Small" font-color="Muted" text-alignment="center" transparent="true"/>
      <view class="COptionMenu" control-tag="PadLock" origin="468, 253" size="96, 22" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
      <view class="CTextLabel" origin="582, 238" size="96, 14" title="SYNTH" font="Small" font-color="Muted" text-alignment="center" transparent="true"/>
      <view class="COptionMenu" control-tag="SynthLock" origin="582, 253" size="96, 22" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
    </view>

    <!-- Role shaping / live -->
