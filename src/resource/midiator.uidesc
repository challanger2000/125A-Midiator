    <!-- Footer -->
    <view class="CTextLabel" origin="24, 678" size="812, 16" title="Library-neutral MIDI · Power chords = root + fifth · Velocity 127 reserved" font="Small" font-color="Dim" text-alignment="center" transparent="true"/>
