      <view class="CTextLabel" origin="212, 72" size="70, 16" title="DENSITY" font="Small" font-color="Dim" transparent="true"/>
      <view class="CSlider" control-tag="DrumDensity" origin="276, 72" size="74, 16" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
