      <view class="CSlider" control-tag="PowerChords" origin="474, 138" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="PowerChords" origin="570, 137" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <view class="CTextLabel" origin="644, 98" size="134, 16" title="PALM MUTE AMOUNT" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="PalmMute" origin="644, 118" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="PalmMute" origin="740, 117" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>
      <view class="CTextLabel" origin="644, 143" size="82, 16" title="PM &lt; VEL" font="Small" font-color="Dim" transparent="true"/>
      <view class="CTextEdit" control-tag="PalmMuteVelocity" origin="730, 141" size="48, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>
      <view class="CTextLabel" origin="730, 160" size="48, 14" title="LIVE" font="Small" font-color="Accent" text-alignment="center" transparent="true"/>

      <!-- Variation and actions -->
      <view class="CTextLabel" origin="18, 166" size="180, 16" title="VARIATION AMOUNT" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="VariationAmount" origin="18, 187" size="226, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
