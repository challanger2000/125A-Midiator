<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <bitmaps>
    <bitmap name="BrandLogo" path="125A_Logo.png"/>
  </bitmaps>
  <colors>
    <color name="Bg" rgba="#0D1115FF"/>
    <color name="Panel" rgba="#151C22FF"/>
    <color name="Panel2" rgba="#1B242BFF"/>
    <color name="Text" rgba="#E7ECEFFF"/>
    <color name="Muted" rgba="#9AA7B0FF"/>
    <color name="Dim" rgba="#6F7B83FF"/>
    <color name="Accent" rgba="#62C7B3FF"/>
    <color name="AccentDark" rgba="#20453FFF"/>
    <color name="Button" rgba="#202A31FF"/>
    <color name="ButtonHi" rgba="#2B5C53FF"/>
    <color name="ButtonEdge" rgba="#35434CFF"/>
    <color name="PanelEdge" rgba="#24313AFF"/>
    <color name="Line" rgba="#2B353DFF"/>
  </colors>
  <fonts>
    <font name="Title" font-name="Arial" size="22" bold="true" italic="false"/>
    <font name="Heading" font-name="Arial" size="14" bold="true" italic="false"/>
    <font name="Normal" font-name="Arial" size="12" bold="false" italic="false"/>
    <font name="Small" font-name="Arial" size="11" bold="false" italic="false"/>
    <font name="ButtonFont" font-name="Arial" size="13" bold="true" italic="false"/>
  </fonts>
  <gradients>
    <gradient name="ButtonIdle"><color-stop rgba="#2A353EFF" start="0"/><color-stop rgba="#1B242BFF" start="1"/></gradient>
    <gradient name="ButtonActive"><color-stop rgba="#3E897AFF" start="0"/><color-stop rgba="#21564DFF" start="1"/></gradient>
    <gradient name="ButtonPrimary"><color-stop rgba="#327466FF" start="0"/><color-stop rgba="#214B44FF" start="1"/></gradient>
    <gradient name="ButtonPrimaryActive"><color-stop rgba="#58B6A3FF" start="0"/><color-stop rgba="#2D6B60FF" start="1"/></gradient>
  </gradients>
  <control-tags>
    <control-tag name="Root" tag="100"/>
    <control-tag name="Scale" tag="101"/>
    <control-tag name="Bars" tag="102"/>
    <control-tag name="Density" tag="103"/>
    <control-tag name="Complexity" tag="104"/>
    <control-tag name="Repetition" tag="105"/>
    <control-tag name="PowerChords" tag="106"/>
    <control-tag name="PalmMute" tag="107"/>
    <control-tag name="VariationAmount" tag="108"/>
    <control-tag name="NewRiff" tag="109"/>
    <control-tag name="Variation" tag="110"/>
    <control-tag name="RootSource" tag="111"/>
    <control-tag name="LegacyStyle" tag="112"/>
    <control-tag name="PowerChordsEnabled" tag="113"/>
    <control-tag name="DrumMap" tag="114"/>
    <control-tag name="BassFollow" tag="115"/>
    <control-tag name="BassMovement" tag="116"/>
    <control-tag name="DrumDensity" tag="117"/>
    <control-tag name="DrumComplexity" tag="118"/>
    <control-tag name="PadSpread" tag="119"/>
    <control-tag name="PadTension" tag="120"/>
    <control-tag name="SynthActivity" tag="121"/>
    <control-tag name="SynthMovement" tag="122"/>
    <control-tag name="SectionLength" tag="123"/>
    <control-tag name="FillIntensity" tag="124"/>
    <control-tag name="SectionType" tag="125"/>
    <control-tag name="Style" tag="126"/>
  </control-tags>

  <template name="MidiatorView" class="CViewContainer" origin="0, 0" size="860, 730" minSize="645, 548" maxSize="1720, 1460" transparent="false" background-color="Bg">
    <!-- Header -->
    <view class="CView" origin="24, 10" size="118, 59" bitmap="BrandLogo" transparent="true"/>
    <view class="CTextLabel" origin="280, 14" size="300, 30" title="MIDIATOR" font="Title" font-color="Text" text-alignment="center" transparent="true"/>
    <view class="CTextLabel" origin="250, 45" size="360, 18" title="RIFF IDEAS  ·  THEORY HELP  ·  MIDI OUT" font="Small" font-color="Muted" text-alignment="center" transparent="true"/>
    <view class="CTextLabel" origin="738, 18" size="96, 18" title="V0.1 TEST" font="Small" font-color="Dim" text-alignment="right" transparent="true"/>

    <!-- Tonal frame -->
    <view class="CViewContainer" origin="24, 82" size="812, 130" transparent="false" background-color="Panel">
      <view class="CTextLabel" origin="18, 12" size="210, 18" title="TONAL FRAME" font="Heading" font-color="Accent" transparent="true"/>
      <view class="CView" origin="18, 34" size="776, 1" transparent="false" background-color="PanelEdge"/>

      <view class="CTextLabel" origin="18, 47" size="48, 16" title="ROOT" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="Root" origin="68, 41" size="104, 30" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="194, 47" size="48, 16" title="SCALE" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="Scale" origin="244, 41" size="218, 30" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="472, 47" size="52, 16" title="LENGTH" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="SectionLength" origin="526, 41" size="82, 30" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="626, 47" size="78, 16" title="ROOT SOURCE" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="RootSource" origin="706, 41" size="88, 30" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" midiator-id="theoryKey" origin="18, 82" size="270, 20" title="A  Phrygian" font="Heading" font-color="Text" transparent="true"/>
      <view class="CTextLabel" midiator-id="theoryNotes" origin="306, 82" size="488, 20" title="Notes: A A# C D E F G" font="Normal" font-color="Text" transparent="true"/>
      <view class="CTextLabel" midiator-id="theoryCharacter" origin="18, 106" size="340, 18" title="Character: dark, tense, aggressive" font="Small" font-color="Muted" transparent="true"/>
      <view class="CTextLabel" midiator-id="theoryInterval" origin="404, 106" size="390, 18" title="Signature: minor 2nd above the root" font="Small" font-color="Muted" transparent="true"/>
    </view>

    <!-- Riff shape -->
    <view class="CViewContainer" origin="24, 226" size="812, 248" transparent="false" background-color="Panel">
      <view class="CTextLabel" origin="18, 12" size="96, 18" title="RIFF SHAPE" font="Heading" font-color="Accent" transparent="true"/>
      <view class="CTextLabel" origin="120, 13" size="58, 16" title="SECTION" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="SectionType" origin="180, 7" size="124, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
      <view class="CTextLabel" origin="320, 13" size="66, 16" title="DRUM MAP" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="DrumMap" origin="388, 7" size="138, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
      <view class="CTextLabel" origin="544, 13" size="48, 16" title="STYLE" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="Style" origin="594, 7" size="200, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
      <view class="CView" origin="18, 42" size="776, 1" transparent="false" background-color="PanelEdge"/>

      <!-- Main shaping controls on a strict five-column grid -->
      <view class="CTextLabel" origin="18, 54" size="134, 18" title="DENSITY" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="Density" origin="18, 78" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="Density" origin="114, 77" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <view class="CTextLabel" origin="170, 54" size="134, 18" title="COMPLEXITY" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="Complexity" origin="170, 78" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="Complexity" origin="266, 77" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <view class="CTextLabel" origin="322, 54" size="134, 18" title="REPETITION" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="Repetition" origin="322, 78" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="Repetition" origin="418, 77" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <view class="CTextLabel" origin="474, 54" size="90, 18" title="POWER CHORDS" font="Small" font-color="Muted" transparent="true"/>
      <view class="COptionMenu" control-tag="PowerChordsEnabled" origin="568, 50" size="58, 24" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
      <view class="CSlider" control-tag="PowerChords" origin="474, 78" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="PowerChords" origin="570, 77" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <view class="CTextLabel" origin="644, 54" size="134, 18" title="PALM MUTE" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="PalmMute" origin="644, 78" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="PalmMute" origin="740, 77" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <!-- Variation control and actions -->
      <view class="CTextLabel" origin="18, 124" size="180, 18" title="VARIATION AMOUNT" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="VariationAmount" origin="18, 150" size="226, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="VariationAmount" origin="250, 149" size="42, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <view class="CTextButton" control-tag="NewRiff" origin="322, 126" size="222, 58" title="NEW RIFF" text-color="Text" text-color-highlighted="Text" font="ButtonFont" frame-color="AccentDark" frame-color-highlighted="Accent" frame-width="1" round-radius="5" gradient="ButtonPrimary" gradient-highlighted="ButtonPrimaryActive" kick-style="true"/>
      <view class="CTextButton" control-tag="Variation" origin="562, 126" size="216, 58" title="VARIATION" text-color="Text" text-color-highlighted="Text" font="ButtonFont" frame-color="ButtonEdge" frame-color-highlighted="AccentDark" frame-width="1" round-radius="5" gradient="ButtonIdle" gradient-highlighted="ButtonActive" kick-style="true"/>

      <view class="CView" origin="18, 200" size="776, 1" transparent="false" background-color="PanelEdge"/>
      <view class="CTextLabel" origin="18, 212" size="776, 18" title="VARIATION preserves root, scale and phrase length.  NEW RIFF generates a fresh idea from the current settings." font="Small" font-color="Dim" text-alignment="center" transparent="true"/>
    </view>

    <!-- Role shaping -->
    <view class="CViewContainer" origin="24, 490" size="812, 170" transparent="false" background-color="Panel">
      <view class="CTextLabel" origin="18, 12" size="210, 18" title="ROLE SHAPING" font="Heading" font-color="Accent" transparent="true"/>
      <view class="CView" origin="18, 36" size="776, 1" transparent="false" background-color="PanelEdge"/>

      <view class="CTextLabel" origin="18, 48" size="176, 18" title="BASS" font="Small" font-color="Muted" text-alignment="center" transparent="true"/>
