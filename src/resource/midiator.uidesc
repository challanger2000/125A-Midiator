<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <bitmaps>
    <bitmap name="BrandLogo" path="125A_Logo.png"/>
  </bitmaps>
  <colors>
    <color name="Bg" rgba="#0D1115FF"/>
    <color name="Panel" rgba="#151C22FF"/>
    <color name="Panel2" rgba="#1B242BFF"/>
    <color name="Text" rgba="#E7ECEFFF"/>
    <color name="Muted" rgba="#9AA7B0FF"/>
    <color name="Dim" rgba="#6F7B83FF"/>
    <color name="Accent" rgba="#62C7B3FF"/>
    <color name="AccentDark" rgba="#20453FFF"/>
    <color name="Button" rgba="#202A31FF"/>
    <color name="ButtonHi" rgba="#2B5C53FF"/>
    <color name="ButtonEdge" rgba="#35434CFF"/>
    <color name="PanelEdge" rgba="#24313AFF"/>
    <color name="Line" rgba="#2B353DFF"/>
  </colors>
  <fonts>
    <font name="Title" font-name="Arial" size="22" bold="true" italic="false"/>
    <font name="Heading" font-name="Arial" size="14" bold="true" italic="false"/>
    <font name="Normal" font-name="Arial" size="12" bold="false" italic="false"/>
    <font name="Small" font-name="Arial" size="11" bold="false" italic="false"/>
    <font name="ButtonFont" font-name="Arial" size="13" bold="true" italic="false"/>
  </fonts>
  <gradients>
    <gradient name="ButtonIdle"><color-stop rgba="#2A353EFF" start="0"/><color-stop rgba="#1B242BFF" start="1"/></gradient>
    <gradient name="ButtonActive"><color-stop rgba="#3E897AFF" start="0"/><color-stop rgba="#21564DFF" start="1"/></gradient>
    <gradient name="ButtonPrimary"><color-stop rgba="#327466FF" start="0"/><color-stop rgba="#214B44FF" start="1"/></gradient>
    <gradient name="ButtonPrimaryActive"><color-stop rgba="#58B6A3FF" start="0"/><color-stop rgba="#2D6B60FF" start="1"/></gradient>
  </gradients>
  <control-tags>
    <control-tag name="Root" tag="100"/>
    <control-tag name="Scale" tag="101"/>
    <control-tag name="Bars" tag="102"/>
    <control-tag name="Density" tag="103"/>
    <control-tag name="Complexity" tag="104"/>
    <control-tag name="Repetition" tag="105"/>
    <control-tag name="PowerChords" tag="106"/>
    <control-tag name="PalmMute" tag="107"/>
    <control-tag name="VariationAmount" tag="108"/>
    <control-tag name="NewRiff" tag="109"/>
    <control-tag name="Variation" tag="110"/>
    <control-tag name="RootSource" tag="111"/>
    <control-tag name="LegacyStyle" tag="112"/>
    <control-tag name="PowerChordsEnabled" tag="113"/>
    <control-tag name="LegacyDrumMap" tag="114"/>
    <control-tag name="BassFollow" tag="115"/>
    <control-tag name="BassMovement" tag="116"/>
    <control-tag name="DrumDensity" tag="117"/>
    <control-tag name="DrumComplexity" tag="118"/>
    <control-tag name="PadSpread" tag="119"/>
    <control-tag name="PadTension" tag="120"/>
    <control-tag name="SynthActivity" tag="121"/>
    <control-tag name="SynthMovement" tag="122"/>
    <control-tag name="SectionLength" tag="123"/>
    <control-tag name="FillIntensity" tag="124"/>
    <control-tag name="SectionType" tag="125"/>
    <control-tag name="Style" tag="126"/>
    <control-tag name="PalmMuteVelocity" tag="127"/>
    <control-tag name="Trigger" tag="128"/>
    <control-tag name="GuitarLock" tag="129"/>
    <control-tag name="BassLock" tag="130"/>
    <control-tag name="DrumsLock" tag="131"/>
    <control-tag name="PadLock" tag="132"/>
    <control-tag name="SynthLock" tag="133"/>
    <control-tag name="Humanize" tag="134"/>
    <control-tag name="DrumMap" tag="135"/>
  </control-tags>

  <template name="MidiatorView" class="CViewContainer" origin="0, 0" size="860, 730" minSize="645, 548" maxSize="1720, 1460" transparent="false" background-color="Bg">
    <!-- Header -->
    <view class="CView" origin="24, 10" size="118, 59" bitmap="BrandLogo" transparent="true"/>
    <view class="CTextLabel" origin="280, 12" size="300, 30" title="MIDIATOR" font="Title" font-color="Text" text-alignment="center" transparent="true"/>
    <view class="CTextLabel" origin="250, 43" size="360, 18" title="METAL MIDI ACCOMPANIMENT" font="Small" font-color="Muted" text-alignment="center" transparent="true"/>
    <view class="CTextLabel" origin="738, 18" size="96, 18" title="V0.1 TEST" font="Small" font-color="Dim" text-alignment="right" transparent="true"/>

    <!-- Tonal / playback -->
    <view class="CViewContainer" origin="24, 82" size="812, 130" transparent="false" background-color="Panel">
      <view class="CTextLabel" origin="18, 10" size="180, 18" title="TONAL / PLAYBACK" font="Heading" font-color="Accent" transparent="true"/>
      <view class="CTextLabel" origin="360, 11" size="434, 16" title="ROOT SOURCE = PITCH INPUT   ·   TRIGGER = START / STOP" font="Small" font-color="Muted" text-alignment="right" transparent="true"/>
      <view class="CView" origin="18, 32" size="776, 1" transparent="false" background-color="PanelEdge"/>

      <view class="CTextLabel" origin="18, 40" size="96, 16" title="ROOT" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="Root" origin="18, 57" size="96, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="128, 40" size="202, 16" title="SCALE / MODE" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="Scale" origin="128, 57" size="202, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="344, 40" size="82, 16" title="LENGTH" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="SectionLength" origin="344, 57" size="82, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="440, 40" size="118, 16" title="ROOT SOURCE" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="RootSource" origin="440, 57" size="118, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="572, 40" size="132, 16" title="TRIGGER" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="Trigger" origin="572, 57" size="132, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" midiator-id="theoryKey" origin="18, 94" size="230, 20" title="A  Phrygian" font="Heading" font-color="Text" transparent="true"/>
      <view class="CTextLabel" midiator-id="theoryNotes" origin="260, 94" size="534, 20" title="Notes: A A# C D E F G" font="Normal" font-color="Text" text-alignment="right" transparent="true"/>
      <view class="CTextLabel" midiator-id="theoryCharacter" origin="18, 112" size="380, 16" title="Character: dark, tense, aggressive" font="Small" font-color="Muted" transparent="true"/>
      <view class="CTextLabel" midiator-id="theoryInterval" origin="414, 112" size="380, 16" title="Signature: minor 2nd above the root" font="Small" font-color="Muted" text-alignment="right" transparent="true"/>
    </view>

    <!-- Riff generation -->
    <view class="CViewContainer" origin="24, 226" size="812, 270" transparent="false" background-color="Panel">
      <view class="CTextLabel" origin="18, 10" size="180, 18" title="RIFF GENERATION" font="Heading" font-color="Accent" transparent="true"/>
      <view class="CTextLabel" origin="300, 11" size="494, 16" title="SHAPE CONTROLS APPLY TO NEW RIFF / VARIATION" font="Small" font-color="Muted" text-alignment="right" transparent="true"/>
      <view class="CView" origin="18, 32" size="776, 1" transparent="false" background-color="PanelEdge"/>

      <view class="CTextLabel" origin="18, 40" size="130, 16" title="SECTION" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="SectionType" origin="18, 57" size="130, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="162, 40" size="170, 16" title="DRUM MAP" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="DrumMap" origin="162, 57" size="170, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="346, 40" size="260, 16" title="METAL STYLE" font="Small" font-color="Dim" transparent="true"/>
      <view class="COptionMenu" control-tag="Style" origin="346, 57" size="260, 28" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>

      <view class="CTextLabel" origin="620, 40" size="174, 16" title="RECOMMENDED TEMPO" font="Small" font-color="Dim" text-alignment="center" transparent="true"/>
      <view class="CTextLabel" midiator-id="styleBpm" origin="620, 59" size="174, 22" title="REC. BPM 100-135" font="Heading" font-color="Accent" text-alignment="center" transparent="true"/>

      <!-- Generation-shape five-column grid -->
      <view class="CTextLabel" origin="18, 98" size="134, 16" title="DENSITY" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="Density" origin="18, 118" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="Density" origin="114, 117" size="38, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>

      <view class="CTextLabel" origin="170, 98" size="134, 16" title="COMPLEXITY" font="Small" font-color="Muted" transparent="true"/>
      <view class="CSlider" control-tag="Complexity" origin="170, 118" size="92, 18" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
