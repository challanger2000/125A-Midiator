      <view class="CTextLabel" origin="118, 240" size="676, 14" title="LOCKED PARTS ARE PROTECTED FROM NEW RIFF / VARIATION" font="Small" font-color="Dim" text-alignment="right" transparent="true"/>

      <view class="CTextLabel" origin="126, 238" size="96, 14" title="GUITAR" font="Small" font-color="Muted" text-alignment="center" transparent="true"/>
      <view class="COptionMenu" control-tag="GuitarLock" origin="126, 253" size="96, 22" font-color="Text" back-color="Panel2" frame-color="Line" frame-width="1" menu-popup-style="true"/>
