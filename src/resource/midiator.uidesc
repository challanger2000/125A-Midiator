      <view class="CTextLabel" origin="212, 106" size="70, 16" title="COMPLEX." font="Small" font-color="Dim" transparent="true"/>
      <view class="CSlider" control-tag="DrumComplexity" origin="276, 106" size="74, 16" mode="free click" orientation="horizontal" transparent="false" draw-back="true" draw-frame="true" draw-value="true" draw-value-from-center="false" draw-back-color="Panel2" draw-frame-color="Line" draw-value-color="Accent" handle-offset="0, 0" wheel-inc-value="0.02"/>
      <view class="CTextEdit" control-tag="DrumComplexity" origin="354, 104" size="34, 20" back-color="Panel2" frame-color="Line" frame-width="1" font-color="Text" font="Small" text-alignment="center" value-precision="0" immediate-text-change="false" transparent="false"/>
      <view class="CTextLabel" origin="212, 138" size="70, 16" title="FILL" font="Small" font-color="Dim" transparent="true"/>
